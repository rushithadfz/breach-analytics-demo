# Production build settings. Vite layers .env.production over .env, so
# these win for `npm run build` while local development keeps using .env.
#
# Committed on purpose: it contains no secret, and its job is to make the
# safe thing the default. Without it, a developer's local .env — which
# does hold a key — gets inlined into the production bundle, where every
# visitor can read it out of the served JavaScript.

# Same origin: the API is served by the same process as these files, so
# no hostname needs to be known at build time.
VITE_API_BASE_URL=/api/v1

# Deliberately empty. The browser authenticates with the httpOnly
# session cookie the server sets when it serves the app shell, and never
# holds a credential it could leak. See backend/app/api/v1/deps.py.
VITE_API_KEY=
